# PostgreSQL connection used by the API and MQTT collector.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smarthome
DB_USER=smarthome
DB_PASSWORD=replace-with-a-strong-password

# Local Mosquitto broker used by the MQTT collector.
MQTT_BROKER=localhost
MQTT_PORT=1883

# Outdoor weather location for the backend Open-Meteo request.
WEATHER_LAT=49.84
WEATHER_LON=24.03
WEATHER_LOCATION_NAME=Lviv

# Optional Zigbee coordinator. Prefer a stable /dev/serial/by-id/... path.
# Only an explicitly configured path is checked; other USB serial devices are ignored.
# ZIGBEE_SERIAL_DEVICE=/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0

# One real Zigbee PIR sensor; an empty topic disables motion collection.
# Use the exact Zigbee2MQTT topic (update it here if the device is renamed).
MOTION_SENSOR_TOPIC=
MOTION_SENSOR_ID=
MOTION_SENSOR_NAME="Motion sensor"
MOTION_SENSOR_ROOM="Living room"
